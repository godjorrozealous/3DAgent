# ========== 端口配置 ==========
# PLD 诊断平台端口（内网 5000 被其他程序占用，本包统一使用 6000）
FLASK_PORT=6000
# 本项目后端访问 PLD 的地址（同机部署保持 localhost 即可）
PLD_BASE=http://localhost:6000
# 本项目后端端口（前端由后端托管，浏览器入口即此端口）
BACKEND_PORT=8100
BACKEND_HOST=0.0.0.0

# ========== 诊断策略 ==========
# 默认激活的策略名（对应 pld/data/active_weights.json / pld/skills/）
PLD_ACTIVE_SKILL=comprehensive_diagnosis

# ========== 外部服务（同机已运行，仅做连通性检查，不由本包启动）==========
# 8000 数据平台（tgyApiservice） / 8001 雷电 / 8002 覆冰 / 8003 风偏 / 8004 鸟害 / 8005 微气象
CHECK_PORTS="8000 8001 8002 8003 8004 8005"
